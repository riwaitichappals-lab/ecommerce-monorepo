# -----------------------------------------------------------------------------
# Ecommerce API server — environment variables
# Copy to the MONOREPO ROOT as .env (shared by apps/api and apps/admin). NEVER commit .env or real secrets.
# Every variable is documented in docs/development/environment.md.
# -----------------------------------------------------------------------------

# --- Server --------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Set to true behind a load balancer / reverse proxy so client IPs are correct.
TRUST_PROXY=false

# --- Database (Supabase Postgres) ----------------------------------------------
# Supabase dashboard → Connect → "Transaction pooler" (port 6543) for the server,
# or "Session pooler" / direct connection (port 5432) for migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# --- Supabase Auth --------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if your project still signs tokens with the legacy HS256 JWT secret.
# Projects using JWT signing keys (ES256/RS256) are verified via JWKS and can leave this empty.
SUPABASE_JWT_SECRET=
# Not used by the server at runtime (listed so a shared .env validates). Keep secret.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ImageKit -------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_UPLOAD_FOLDER=/products
# Verify each registered image with the ImageKit API before storing it.
IMAGEKIT_VERIFY_UPLOADS=true

# --- HTTP -----------------------------------------------------------------------
# Comma-separated allow-list. Required in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
CHECKOUT_RATE_LIMIT_MAX=10
# Cache-Control max-age (seconds) for public storefront responses.
STORE_CACHE_MAX_AGE=60
# Defaults to true outside production. Serves Swagger UI at /docs.
ENABLE_API_DOCS=

# --- Storefront cache purge -------------------------------------------------------
# After catalogue writes the API calls the storefront's revalidation webhook. If either
# value is empty the call is skipped (one warning at startup), so local dev works as is.
# REVALIDATE_SECRET must equal REVALIDATE_SECRET in the storefront's .env. Server-side only.
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# --- Commerce -------------------------------------------------------------------
CURRENCY=USD
SHIPPING_FLAT_RATE=5
FREE_SHIPPING_THRESHOLD=100

# --- Background jobs ------------------------------------------------------------
# How often to retry failed ImageKit deletions. 0 disables the in-process job.
ASSET_CLEANUP_INTERVAL_MS=300000

# --- Admin panel (Vite) ---------------------------------------------------------
# Only VITE_* variables reach the browser bundle. Shared values are referenced.
# The ImageKit private key and Supabase service-role key must NEVER get a VITE_ copy.
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_IMAGEKIT_URL_ENDPOINT=${IMAGEKIT_URL_ENDPOINT}
VITE_API_BASE_URL=
VITE_API_MOCK=
